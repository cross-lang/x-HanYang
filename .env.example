# ─── App ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── Server ──────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# ─── Database (MySQL async) ─────────────────────
# 格式: mysql+asyncmy://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/hanyang?charset=utf8mb4

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://:123456@localhost:6379/0

# ─── Auth (JWT) ─────────────────────────────────
AUTH_SECRET_KEY=change-me-jwt-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS ───────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Storage ────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
