# ─── App ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── Server ──────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# ─── Database (MySQL async) ─────────────────────
# 格式: mysql+asyncmy://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/hanyang?charset=utf8mb4

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://:123456@localhost:6379/0

# ─── Auth (JWT) ─────────────────────────────────
AUTH_SECRET_KEY=change-me-jwt-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS ───────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ─── Storage ────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data

# ─── Logging ────────────────────────────────────
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOGGING_LEVEL=INFO
# 控制台格式: "json" (生产，适合 Loki/ELK) 或 "console" (开发，彩色可读)
LOGGING_FORMAT=console
# 日志文件路径（支持 loguru 时间变量，如 {time:YYYYMMDDHH}）
LOGGING_FILE_PATH=logs/x-HanYang-{time:YYYYMMDDHH}.log
# 日志轮转: "1 hour"、"1 day"、"100 MB" 等
LOGGING_ROTATION=1 hour
# 日志保留: "7 days"、"30 days" 等
LOGGING_RETENTION=7 days
